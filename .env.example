# SQLite by default (file under data_dir). Set postgres URL for Docker compose.
DATABASE_URL=sqlite:///./.agenteval/agenteval.db

AGENTEVAL_DATA_DIR=.agenteval

DEFAULT_JUDGE_MODEL=gemini-3.8-flash
ENABLE_LLM_JUDGE=false

MAX_CONCURRENT_CASES=4
MAX_CONCURRENT_JUDGES=2
DEFAULT_TIMEOUT_SECONDS=300

LOG_LEVEL=INFO
LOG_JSON=true

# Optional — only if ENABLE_LLM_JUDGE=true
# GOOGLE_API_KEY=
